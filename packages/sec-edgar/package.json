{
  "name": "@rayterion/sec-edgar",
  "version": "1.0.0",
  "description": "Public, read-only SEC EDGAR data client",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/yauzl": "^2.10.3",
    "typescript": "^5.9.2",
    "yazl": "^3.3.1"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.1",
    "htmlparser2": "^12.0.0",
    "yauzl": "^3.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rayterion/sec_edgar_api.git",
    "directory": "packages/sec-edgar"
  },
  "bugs": {
    "url": "https://github.com/rayterion/sec_edgar_api/issues"
  },
  "homepage": "https://rayterion.github.io/sec_edgar_api/",
  "keywords": [
    "sec",
    "edgar",
    "xbrl",
    "financial-statements",
    "filings"
  ],
  "publishConfig": {
    "access": "public"
  }
}
