{
  "name": "sec-edgar-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w packages/sec-edgar",
    "typecheck": "npm run typecheck -w packages/sec-edgar",
    "test": "npm run test -w packages/sec-edgar",
    "docs:build": "npm run build -w apps/docs",
    "pack:smoke": "node test/packed-import.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run typecheck:examples && npm run build && npm test && npm run coverage && npm run security:check && npm run pack:smoke && npm run docs:examples && npm run docs:build",
    "format": "prettier --write \"packages/sec-edgar/src/**/*.ts\" \"packages/sec-edgar/test/*.mjs\" \"examples/*.{js,ts,mjs}\" \"apps/docs/docs/**/*.md\" \"test/*.mjs\" \"test/fixtures/manifest.json\" \"apps/docs/*.{cjs,json}\" \"*.md\" \"*.json\" \"apps/docs/*.json\" \"packages/sec-edgar/*.json\"",
    "format:check": "prettier --check \"packages/sec-edgar/src/**/*.ts\" \"packages/sec-edgar/test/*.mjs\" \"examples/*.{js,ts,mjs}\" \"apps/docs/docs/**/*.md\" \"test/*.mjs\" \"test/fixtures/manifest.json\" \"apps/docs/*.{cjs,json}\" \"*.md\" \"*.json\" \"apps/docs/*.json\" \"packages/sec-edgar/*.json\"",
    "lint": "eslint packages/sec-edgar/src packages/sec-edgar/test examples test/*.mjs",
    "docs:examples": "node test/docs-examples.mjs",
    "live:smoke": "node test/live-smoke.mjs",
    "typecheck:examples": "tsc -p examples/tsconfig.json",
    "coverage": "node test/coverage-gate.mjs",
    "security:check": "npm audit --omit=dev --workspace packages/sec-edgar"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.13.6",
    "eslint": "^9.39.1",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.70.1"
  }
}
